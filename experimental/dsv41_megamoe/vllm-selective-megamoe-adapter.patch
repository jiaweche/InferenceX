+def test_mori_finalize_uses_source_routing_ids() -> None:
+    mori_op = _FakeMoriOp()
+    prepare_finalize = MoriPrepareAndFinalize(
+        mori_op,
+        max_tokens_per_rank=8,
+        num_dispatchers=4,
+    )
+    source_ids = torch.tensor([[1, 2], [3, 4]], dtype=torch.int32)
+    prepared = prepare_finalize.prepare(
+        torch.zeros((2, 3), dtype=torch.bfloat16),
+        torch.zeros((2, 2), dtype=torch.float32),
+        source_ids,
+        num_experts=8,
+        expert_map=None,
+        apply_router_weight_on_input=False,
+        quant_config=FusedMoEQuantConfig.make(),
+    )
+    dispatched_ids = prepared[3]
+    output = torch.empty((2, 3), dtype=torch.bfloat16)
+    prepare_finalize.finalize(
+        output,
+        torch.zeros((5, 3), dtype=torch.bfloat16),
+        prepared[4],
+        dispatched_ids,
+        apply_router_weight_on_input=False,
+        weight_and_reduce_impl=SimpleNamespace(),
+    )
+
+    assert mori_op.combine_ids is source_ids
+    assert prepare_finalize._source_topk_ids is None
