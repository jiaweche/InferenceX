+def _manager_for_selection_agreement() -> MoriAll2AllManager:
+    manager = object.__new__(MoriAll2AllManager)
+    manager.world_size = 4
+    manager.cpu_group = object()
+    manager._aiter_mega_moe_v2_lock = threading.RLock()
+    manager._aiter_mega_moe_v2_selection_local = torch.empty(
+        2,
+        dtype=torch.int64,
+    )
+    manager._aiter_mega_moe_v2_selection_gathered = torch.empty(
+        manager.world_size * 2,
+        dtype=torch.int64,
+    )
+    return manager
+
