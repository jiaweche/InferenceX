+def _metadata(
+    *,
+    num_decodes: int = 0,
+    num_prefills: int = 1,
+    num_decode_tokens: int = 0,
+    num_prefill_tokens: int = 888,
+) -> DeepseekSparseSWAMetadata:
+    return DeepseekSparseSWAMetadata(
+        block_table=torch.empty((0, 0), dtype=torch.int32),
+        slot_mapping=torch.empty(0, dtype=torch.int64),
+        block_size=1,
+        num_decodes=num_decodes,
+        num_prefills=num_prefills,
+        num_decode_tokens=num_decode_tokens,
+        num_prefill_tokens=num_prefill_tokens,
+    )
+
+
+def _context(
+    metadata: DeepseekSparseSWAMetadata | None = None,
+    *,
+    include_metadata: bool = True,
+    graph_mode: CUDAGraphMode = CUDAGraphMode.NONE,
+    padding: bool = False,
+    dbo: bool = False,
+) -> ForwardContext:
+    if metadata is None:
+        metadata = _metadata()
+    attn_metadata = {"swa": metadata} if include_metadata else {}
+    return ForwardContext(
+        no_compile_layers={},
+        attn_metadata=attn_metadata,
+        slot_mapping={},
+        cudagraph_runtime_mode=graph_mode,
+        is_padding=torch.tensor([padding]),
+        ubatch_slices=object() if dbo else None,  # type: ignore[arg-type]
+    )
+
+
