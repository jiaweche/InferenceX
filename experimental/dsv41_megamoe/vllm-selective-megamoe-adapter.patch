+class _FakePreparedSelectionManager:
+    def __init__(
+        self,
+        *,
+        prepared_result: tuple[bool, bool],
+        runtime_result: tuple[bool, bool] | None = None,
+    ):
+        self.prepared_result = prepared_result
+        self.runtime_result = runtime_result
+        self.finish_calls = 0
+        self.agree_calls = []
+
+    def finish_aiter_mega_moe_v2_selection(self, agreement):
+        assert agreement == "prepared"
+        self.finish_calls += 1
+        return self.prepared_result
+
+    def agree_aiter_mega_moe_v2_selection(self, eligible, raw_m):
+        self.agree_calls.append((eligible, raw_m))
+        if self.runtime_result is not None:
+            return self.runtime_result
+        return eligible, True
+
+
+def _adapter_for_selection() -> AiterMegaMoEV2Adapter:
+    adapter = object.__new__(AiterMegaMoEV2Adapter)
+    adapter.workspace_key = ("test",)
+    adapter.token_allowlist = _TOKEN_ALLOWLIST
+    return adapter
+
