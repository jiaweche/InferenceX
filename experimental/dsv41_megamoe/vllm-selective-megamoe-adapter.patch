+) -> None:
+    manager = _manager_for_selection_agreement()
+    calls = []
+
+    def all_gather_into_tensor(output, local, *, group):
+        calls.append((output, local, group))
+        output.copy_(local.repeat(manager.world_size))
+
+    monkeypatch.setattr(
+        "vllm.distributed.device_communicators.all2all.dist.all_gather_into_tensor",
+        all_gather_into_tensor,
