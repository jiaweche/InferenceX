+class _FakeMoriOp:
+    def __init__(self):
+        self.combine_ids = None
+
+    def dispatch(self, a1, topk_weights, scale, topk_ids):
+        del scale, topk_ids
+        dispatch_ids = torch.zeros((5, 2), dtype=torch.int32)
+        dispatch_weights = torch.zeros((5, 2), dtype=torch.float32)
+        return (
+            torch.zeros((5, a1.shape[1]), dtype=a1.dtype),
+            dispatch_weights,
+            None,
+            dispatch_ids,
+            torch.ones(1, dtype=torch.int32),
+        )
+
+    def combine(self, fused_expert_output, scale, topk_ids):
+        del scale
+        self.combine_ids = topk_ids
+        return (torch.zeros_like(fused_expert_output[: topk_ids.shape[0]]),)
+
