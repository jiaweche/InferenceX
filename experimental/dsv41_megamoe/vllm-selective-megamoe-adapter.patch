+                local.expand(self.world_size, 2),
+            )
+            return agreed and bool(local[0].item()), agreed
+
+    def start_aiter_mega_moe_v2_selection(
+        self,
+        eligible: bool,
+        raw_m: int,
+    ) -> AiterMegaMoEV2SelectionAgreement:
+        local = torch.tensor(
+            (int(eligible), raw_m),
+            dtype=torch.int64,
+            device="cpu",
+        )
+        gathered = torch.empty(
+            self.world_size * 2,
+            dtype=torch.int64,
+            device="cpu",
+        )
+        work = dist.all_gather_into_tensor(
+            gathered,
+            local,
+            group=self.cpu_group,
+            async_op=True,
+        )
+        return AiterMegaMoEV2SelectionAgreement(local, gathered, work)
+
+    def finish_aiter_mega_moe_v2_selection(
+        self,
+        agreement: AiterMegaMoEV2SelectionAgreement,
+    ) -> tuple[bool, bool]:
+        with agreement.lock:
+            if agreement.result is None:
+                agreement.work.wait()
+                agreed = torch.equal(
+                    agreement.gathered.view(self.world_size, 2),
+                    agreement.local.expand(self.world_size, 2),
+                )
+                agreement.result = (
+                    agreed and bool(agreement.local[0].item()),
+                    agreed,
+                )
+                agreement.work = None
+            return agreement.result
+
+    def record_aiter_mega_moe_v2(
+        self,
+        path: str,
+        reason: str,
+        raw_m: int,
+        count: int = 1,
+    ) -> None:
+        key = (path, reason, raw_m)
+        self._aiter_mega_moe_v2_counters[key] = (
+            self._aiter_mega_moe_v2_counters.get(key, 0) + count
+        )
+
+    @property
+    def aiter_mega_moe_v2_counters(self) -> dict[tuple[str, str, int], int]:
+        return dict(self._aiter_mega_moe_v2_counters)
+
+    def destroy(self):
+        with self._aiter_mega_moe_v2_lock:
+            try:
+                if self._aiter_mega_moe_v2_workspace is not None:
+                    self._aiter_mega_moe_v2_workspace.close()
+                    self._aiter_mega_moe_v2_workspace = None
+                    self._aiter_mega_moe_v2_workspace_key = None
+                self._aiter_mega_moe_v2_preflight.clear()
+                self.handle_cache._cache.clear()
+                if self._aiter_mega_moe_v2_counters:
+                    logger.info(
+                        "AITER MegaMoEV2 path counters: %s",
+                        self._aiter_mega_moe_v2_counters,
+                    )
+            finally:
+                if self._mori_shmem_initialized:
+                    import mori
+
+                    try:
+                        torch.accelerator.synchronize()
+                        mori.shmem.shmem_barrier_all()
+                        mori.shmem.shmem_finalize()
+                    finally:
+                        _unregister_process_group("mori")
+                        self._mori_shmem_initialized = False

     def _make_all2all_kwargs(
         self,
