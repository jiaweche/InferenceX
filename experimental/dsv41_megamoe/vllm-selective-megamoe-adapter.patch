+class _FakeWork:
+    def __init__(self):
+        self.wait_calls = 0
+
+    def wait(self):
+        self.wait_calls += 1
+
+
+def test_mori_manager_async_selection_owns_buffers_and_waits_once(
+    monkeypatch,
+) -> None:
+    manager = _manager_for_selection_agreement()
+    works = []
+
+    def all_gather_into_tensor(output, local, *, group, async_op):
+        assert group is manager.cpu_group
+        assert async_op
+        output.copy_(local.repeat(manager.world_size))
+        work = _FakeWork()
+        works.append(work)
+        return work
+
+    monkeypatch.setattr(
+        "vllm.distributed.device_communicators.all2all.dist.all_gather_into_tensor",
+        all_gather_into_tensor,
+    )
+
+    first = manager.start_aiter_mega_moe_v2_selection(True, 16380)
+    second = manager.start_aiter_mega_moe_v2_selection(False, 16372)
+
+    assert first.local is not second.local
+    assert first.gathered is not second.gathered
+    assert manager.finish_aiter_mega_moe_v2_selection(first) == (True, True)
+    assert manager.finish_aiter_mega_moe_v2_selection(first) == (True, True)
+    assert manager.finish_aiter_mega_moe_v2_selection(second) == (False, True)
+    assert [work.wait_calls for work in works] == [1, 1]
+
