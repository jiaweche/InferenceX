+def test_guaranteed_fallback_does_not_read_padding(
+    metadata: DeepseekSparseSWAMetadata,
+    raw_m: int,
+    reason: str,
+) -> None:
+    context = _context(metadata)
+    context.is_padding = _UnreadablePadding()  # type: ignore[assignment]
