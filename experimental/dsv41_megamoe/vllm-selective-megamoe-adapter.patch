diff --git a/vllm/model_executor/layers/fused_moe/aiter_mega_moe_v2.py b/vllm/model_executor/layers/fused_moe/aiter_mega_moe_v2.py
new file mode 100644
index 0000000..db5fce9
--- /dev/null
+++ b/vllm/model_executor/layers/fused_moe/aiter_mega_moe_v2.py
@@ -0,0 +1,419 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from collections.abc import Callable
+from dataclasses import dataclass
+from typing import Any
+
+import torch
+
+from vllm.config import CUDAGraphMode, VllmConfig, get_current_vllm_config
+from vllm.forward_context import (
+    ForwardContext,
+    get_forward_context,
+    is_forward_context_available,
+)
+from vllm.logger import init_logger
+from vllm.model_executor.layers.fused_moe.activation import MoEActivation
+from vllm.model_executor.layers.fused_moe.all2all_utils import (
+    get_ep_all2all_manager,
+)
+from vllm.model_executor.layers.fused_moe.config import FusedMoEConfig
+from vllm.model_executor.layers.fused_moe.oracle.mxfp4 import Mxfp4MoeBackend
+from vllm.platforms import current_platform
+from vllm.v1.attention.backends.mla.sparse_swa import DeepseekSparseSWAMetadata
+
+logger = init_logger(__name__)
+
+_TARGET_EXPERTS = 384
+_TARGET_TOPK = 6
+_TARGET_HIDDEN = 5120
+_TARGET_INTERMEDIATE = 2304
+_TARGET_EP_SIZE = 4
+_CACHE_PREFIX = "aiter_mega_moe_v2_selection"
+_PRESELECTION_KEY = "aiter_mega_moe_v2_preselection"
+_COUNTER_PREFIX = "aiter_mega_moe_v2_counter"
+
+
+@dataclass(frozen=True)
+class AiterMegaMoEV2Decision:
+    eligible: bool
+    reason: str
+    raw_m: int
+
+
+@dataclass
+class AiterMegaMoEV2PreparedSelection:
+    decision: AiterMegaMoEV2Decision
+    agreement: Any | None
+
+
+def _metadata_values(context: ForwardContext) -> list[DeepseekSparseSWAMetadata]:
+    if not isinstance(context.attn_metadata, dict):
+        return []
+    return [
+        metadata
+        for metadata in context.attn_metadata.values()
+        if isinstance(metadata, DeepseekSparseSWAMetadata)
+    ]
+
+
+def select_aiter_mega_moe_v2_local(
+    context: ForwardContext,
+    raw_m: int,
+    token_allowlist: tuple[int, ...],
+) -> AiterMegaMoEV2Decision:
+    if torch.cuda.is_available() and torch.cuda.is_current_stream_capturing():
+        return AiterMegaMoEV2Decision(False, "stream_capture", raw_m)
+    if context.cudagraph_runtime_mode != CUDAGraphMode.NONE:
+        return AiterMegaMoEV2Decision(False, "cudagraph", raw_m)
+    if context.ubatch_slices is not None:
+        return AiterMegaMoEV2Decision(False, "dbo", raw_m)
+
+    metadata_values = _metadata_values(context)
+    if not metadata_values:
+        return AiterMegaMoEV2Decision(False, "missing_swa_metadata", raw_m)
+    signatures = {
+        (
+            metadata.num_decodes,
+            metadata.num_prefills,
+            metadata.num_decode_tokens,
+            metadata.num_prefill_tokens,
+        )
+        for metadata in metadata_values
+    }
+    if len(signatures) != 1:
+        return AiterMegaMoEV2Decision(False, "metadata_disagreement", raw_m)
+
+    num_decodes, num_prefills, num_decode_tokens, num_prefill_tokens = next(
+        iter(signatures)
+    )
+    if num_decodes or num_decode_tokens:
+        reason = "mixed" if num_prefills or num_prefill_tokens else "decode"
+        return AiterMegaMoEV2Decision(False, reason, raw_m)
+    if not num_prefills or num_prefill_tokens != raw_m:
+        return AiterMegaMoEV2Decision(False, "not_pure_prefill", raw_m)
+    if raw_m not in token_allowlist:
+        return AiterMegaMoEV2Decision(False, "unlisted_m", raw_m)
+    if context.is_padding is not None and bool(context.is_padding.any().item()):
+        return AiterMegaMoEV2Decision(False, "padding", raw_m)
+    return AiterMegaMoEV2Decision(True, "eligible", raw_m)
+
+
+def prepare_aiter_mega_moe_v2_forward_context(
+    context: ForwardContext,
+    raw_m: int,
+    vllm_config: VllmConfig,
+) -> None:
+    if _PRESELECTION_KEY in context.additional_kwargs:
+        return
+    decision = select_aiter_mega_moe_v2_local(
+        context,
+        raw_m,
+        vllm_config.kernel_config.aiter_mega_moe_v2_token_allowlist,
+    )
+    agreement = None
+    if decision.reason not in ("stream_capture", "cudagraph"):
+        agreement = get_ep_all2all_manager().start_aiter_mega_moe_v2_selection(
+            decision.eligible,
+            raw_m,
+        )
+    context.additional_kwargs[_PRESELECTION_KEY] = AiterMegaMoEV2PreparedSelection(
+        decision,
+        agreement,
+    )
+
+
+def finish_aiter_mega_moe_v2_forward_context(context: ForwardContext) -> None:
+    prepared = context.additional_kwargs.get(_PRESELECTION_KEY)
+    if prepared is not None and prepared.agreement is not None:
+        get_ep_all2all_manager().finish_aiter_mega_moe_v2_selection(prepared.agreement)
+
+
+def _is_target_geometry(moe: FusedMoEConfig) -> bool:
+    return moe.num_experts == _TARGET_EXPERTS and moe.experts_per_token == _TARGET_TOPK
+
+
+def _validate_static_configuration(
+    moe: FusedMoEConfig,
+    backend: Mxfp4MoeBackend,
+    vllm_config: VllmConfig,
+) -> list[str]:
+    parallel = moe.moe_parallel_config
+    kernel = vllm_config.kernel_config
+    errors = []
+    if not current_platform.is_rocm():
+        errors.append("ROCm is required")
+    else:
+        from vllm.platforms.rocm import on_gfx950
+
+        if not on_gfx950():
+            errors.append("gfx950 is required")
+    if not parallel.use_ep or parallel.ep_size != _TARGET_EP_SIZE:
+        errors.append("TP4/EP4 is required")
+    if parallel.dp_size != 1 or parallel.pcp_size != 1:
+        errors.append("DP1 and PCP1 are required")
+    if parallel.is_sequence_parallel:
+        errors.append("sequence parallel is unsupported")
+    if vllm_config.parallel_config.pipeline_parallel_size != 1:
+        errors.append("PP1 is required")
+    if not parallel.use_mori_kernels:
+        errors.append("intranode Mori all-to-all is required")
+    if parallel.enable_eplb:
+        errors.append("EPLB is unsupported")
+    if moe.hidden_dim != _TARGET_HIDDEN:
+        errors.append(f"hidden size must be {_TARGET_HIDDEN}")
+    if moe.intermediate_size_per_partition != _TARGET_INTERMEDIATE:
+        errors.append(f"intermediate size must be {_TARGET_INTERMEDIATE}")
+    if moe.num_local_experts != _TARGET_EXPERTS // _TARGET_EP_SIZE:
+        errors.append("96 local experts are required")
+    if moe.activation != MoEActivation.SILU:
+        errors.append("SILU activation is required")
+    if backend != Mxfp4MoeBackend.AITER_MXFP4_BF16:
+        errors.append("AITER MXFP4 BF16 backend is required")
+    if moe.max_num_tokens < kernel.aiter_mega_moe_v2_max_tokens:
+        errors.append("scheduler token capacity is smaller than MegaMoEV2 MTPR")
+    if max(kernel.aiter_mega_moe_v2_token_allowlist) > (
+        kernel.aiter_mega_moe_v2_max_tokens
+    ):
+        errors.append("MegaMoEV2 token allowlist exceeds its MTPR")
+    return errors
+
+
+class AiterMegaMoEV2Adapter:
+    def __init__(self, moe: FusedMoEConfig, vllm_config: VllmConfig):
+        self.moe = moe
+        kernel = vllm_config.kernel_config
+        self.max_tokens = kernel.aiter_mega_moe_v2_max_tokens
+        self.token_allowlist = kernel.aiter_mega_moe_v2_token_allowlist
+        self.workspace = None
+        self.workspace_key = (
+            moe.hidden_dim,
+            moe.intermediate_size_per_partition,
+            moe.num_experts,
+            moe.experts_per_token,
+            moe.ep_size,
+            self.max_tokens,
+        )
+
+    @classmethod
+    def maybe_create(
+        cls,
+        moe: FusedMoEConfig,
+        backend: Mxfp4MoeBackend,
+    ) -> "AiterMegaMoEV2Adapter | None":
+        vllm_config = get_current_vllm_config()
+        if not vllm_config.kernel_config.enable_aiter_mega_moe_v2:
+            return None
+        if not _is_target_geometry(moe):
+            return None
+        errors = _validate_static_configuration(moe, backend, vllm_config)
+        manager = get_ep_all2all_manager()
+        if manager.world_size != _TARGET_EP_SIZE:
+            errors.append("Mori manager world size must be four")
+        if manager.internode:
+            errors.append("the first adapter supports intranode Mori only")
+        if errors:
+            raise ValueError(
+                "AITER MegaMoEV2 configuration is unsupported: " + "; ".join(errors)
+            )
+        return cls(moe, vllm_config)
+
+    def _weight_contract_error(self, layer) -> str | None:
+        weights = (
+            ("w13_weight", layer.w13_weight),
+            ("w13_weight_scale", layer.w13_weight_scale),
+            ("w2_weight", layer.w2_weight),
+            ("w2_weight_scale", layer.w2_weight_scale),
+        )
+        expected_numel = (
+            96 * 2 * _TARGET_INTERMEDIATE * (_TARGET_HIDDEN // 2),
+            96 * 2 * _TARGET_INTERMEDIATE * (_TARGET_HIDDEN // 32),
+            96 * _TARGET_HIDDEN * (_TARGET_INTERMEDIATE // 2),
+            96 * _TARGET_HIDDEN * (_TARGET_INTERMEDIATE // 32),
+        )
+        for (name, tensor), numel in zip(weights, expected_numel):
+            if (
+                tensor.device.type != "cuda"
+                or tensor.device.index != torch.cuda.current_device()
+            ):
+                return f"{name}_device"
+            if not tensor.is_contiguous():
+                return f"{name}_contiguous"
+            if tensor.element_size() != 1 or tensor.numel() != numel:
+                return f"{name}_layout"
+        for name, tensor in weights[::2]:
+            if getattr(tensor, "is_shuffled", False) is not True:
+                return f"{name}_shuffle"
+        if layer.apply_router_weight_on_input:
+            return "router_weight_on_input"
+        return None
+
+    def _create_workspace(self, manager, layer):
+        from aiter.ops.flydsl.kernels.mega_moe import MegaMoEV2
+
+        return MegaMoEV2(
+            rank=manager.rank,
+            world_size=manager.world_size,
+            model_dim=self.moe.hidden_dim,
+            inter_dim=self.moe.intermediate_size_per_partition,
+            experts=self.moe.num_experts,
+            topk=self.moe.experts_per_token,
+            quant="a8w4",
+            w1=layer.w13_weight,
+            w1_scale=layer.w13_weight_scale,
+            w2=layer.w2_weight,
+            w2_scale=layer.w2_weight_scale,
+            max_tok_per_rank=self.max_tokens,
+            swiglu_limit=float(self.moe.swiglu_limit or 0.0),
+        )
+
+    def validate_layer_weights(self, layer) -> None:
+        error = self._weight_contract_error(layer)
+        manager = get_ep_all2all_manager()
+        manager.register_aiter_mega_moe_v2_layer(
+            self.workspace_key,
+            error,
+            lambda: self._create_workspace(manager, layer),
+            lambda workspace: setattr(self, "workspace", workspace),
+        )
+
+    def _runtime_contract_error(
+        self,
+        layer,
+        x: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+    ) -> str | None:
+        if x.dtype != torch.bfloat16 or not x.is_contiguous():
+            return "hidden_states"
+        if topk_weights.dtype != torch.float32 or not topk_weights.is_contiguous():
+            return "topk_weights"
+        if topk_ids.dtype != torch.int32 or not topk_ids.is_contiguous():
+            return "topk_ids"
+        if tuple(topk_weights.shape) != (x.shape[0], self.moe.experts_per_token):
+            return "topk_weights_shape"
+        if tuple(topk_ids.shape) != (x.shape[0], self.moe.experts_per_token):
+            return "topk_ids_shape"
+        if layer.apply_router_weight_on_input:
+            return "router_weight_on_input"
+        return None
+
+    def _select(
+        self,
+        x: torch.Tensor,
+        runtime_error_factory: Callable[[], str | None] | None = None,
+    ) -> AiterMegaMoEV2Decision:
+        raw_m = int(x.shape[0])
+        if not is_forward_context_available():
+            return AiterMegaMoEV2Decision(False, "missing_forward_context", raw_m)
+        context = get_forward_context()
+        cache_key = f"{_CACHE_PREFIX}:{self.workspace_key}"
+        cached = context.additional_kwargs.get(cache_key)
+        if cached is not None:
+            if cached.raw_m != raw_m:
+                return AiterMegaMoEV2Decision(False, "cached_m_mismatch", raw_m)
+            return cached
+
+        manager = get_ep_all2all_manager()
+        prepared = context.additional_kwargs.get(_PRESELECTION_KEY)
+        if prepared is not None:
+            decision = prepared.decision
+            if prepared.agreement is None:
+                eligible, agreed = decision.eligible, True
+            else:
+                eligible, agreed = manager.finish_aiter_mega_moe_v2_selection(
+                    prepared.agreement
+                )
+            if not agreed:
+                decision = AiterMegaMoEV2Decision(
+                    False,
+                    "rank_disagreement",
+                    raw_m,
+                )
+            elif decision.eligible != eligible:
+                decision = AiterMegaMoEV2Decision(False, "rank_ineligible", raw_m)
+            elif decision.raw_m != raw_m:
+                decision = AiterMegaMoEV2Decision(
+                    False,
+                    "cached_m_mismatch",
+                    raw_m,
+                )
+            if not eligible:
+                context.additional_kwargs[cache_key] = decision
+                return decision
+        else:
+            decision = select_aiter_mega_moe_v2_local(
+                context,
+                raw_m,
+                self.token_allowlist,
+            )
+        if decision.reason in ("stream_capture", "cudagraph"):
+            context.additional_kwargs[cache_key] = decision
+            return decision
+        runtime_error = (
+            runtime_error_factory()
+            if decision.eligible and runtime_error_factory is not None
+            else None
+        )
+        if runtime_error is not None:
+            decision = AiterMegaMoEV2Decision(False, runtime_error, raw_m)
+        eligible, agreed = manager.agree_aiter_mega_moe_v2_selection(
+            decision.eligible,
+            raw_m,
+        )
+        if not agreed:
+            decision = AiterMegaMoEV2Decision(False, "rank_disagreement", raw_m)
+        elif decision.eligible != eligible:
+            decision = AiterMegaMoEV2Decision(False, "rank_ineligible", raw_m)
+        context.additional_kwargs[cache_key] = decision
+        return decision
+
+    def _record_path(self, manager, decision: AiterMegaMoEV2Decision) -> None:
+        count = 1
+        if is_forward_context_available():
+            context = get_forward_context()
+            counter_key = f"{_COUNTER_PREFIX}:{self.workspace_key}"
+            if counter_key in context.additional_kwargs:
+                return
+            context.additional_kwargs[counter_key] = True
+            count = 40
+        manager.record_aiter_mega_moe_v2(
+            "mega" if decision.eligible else "ordinary",
+            decision.reason,
+            decision.raw_m,
+            count,
+        )
+
+    def maybe_apply(
+        self,
+        layer,
+        x: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+    ) -> torch.Tensor | None:
+        decision = self._select(
+            x,
+            lambda: self._runtime_contract_error(
+                layer,
+                x,
+                topk_weights,
+                topk_ids,
+            ),
+        )
+        manager = get_ep_all2all_manager()
+        self._record_path(manager, decision)
+        if not decision.eligible:
+            return None
+        if self.workspace is None:
+            raise RuntimeError("AITER MegaMoEV2 workspace was not preinitialized")
+        output = self.workspace.forward_with_weights(
+            x,
+            topk_weights,
+            topk_ids,
+            layer.w13_weight,
+            layer.w13_weight_scale,
+            layer.w2_weight,
+            layer.w2_weight_scale,
+        )
+        return output
diff --git a/vllm/model_executor/layers/fused_moe/config.py b/vllm/model_executor/layers/fused_moe/config.py
index 8736b13..e74d690 100644
--- a/vllm/model_executor/layers/fused_moe/config.py
+++ b/vllm/model_executor/layers/fused_moe/config.py
@@ -1051,6 +1051,7 @@ class FusedMoEParallelConfig:
     use_ep: bool  # whether to use EP or not
