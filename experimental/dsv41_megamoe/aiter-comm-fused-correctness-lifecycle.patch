+# SPDX-License-Identifier: MIT
+# Copyright (C) 2024-2026, Advanced Micro Devices, Inc. All rights reserved.
+"""Distributed pooled-workspace and explicit-teardown validation for MegaMoEV2."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+
+os.environ.setdefault("MORI_SHMEM_HEAP_SIZE", "40G")
+
+import torch
+import torch.distributed as dist
+
+from aiter.ops.flydsl.kernels.mega_moe import MegaMoEV2
+from op_tests.multigpu_tests.test_mega_moe_v2 import (
+    NETWORKS,
+    _barrier,
+    _cleanup,
+    _make_inputs,
+    _quantize_weights,
+    _reference,
+    _setup_dist,
+)
+
+
+def _global_rel_l2(output, reference):
+    error_sq = torch.sum((output.float() - reference) ** 2)
+    reference_sq = torch.sum(reference.float() ** 2)
+    dist.all_reduce(error_sq)
+    dist.all_reduce(reference_sq)
+    return float(torch.sqrt(error_sq / reference_sq))
+
+
+def _weight_ptrs(packed):
+    return [tensor.data_ptr() for tensor in packed[:4]]
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--network", choices=NETWORKS, default="dsv41")
+    parser.add_argument("--tokens", type=int, default=888)
+    parser.add_argument("--max-tok-per-rank", type=int, default=8192)
+    parser.add_argument("--alternations", type=int, default=40)
+    parser.add_argument("--accuracy-max-bs", type=int, default=888)
+    parser.add_argument("--rtol", type=float, default=0.10)
+    parser.add_argument("--route-ids-json", type=Path)
+    parser.add_argument("--output-json", type=Path)
+    args = parser.parse_args()
+
+    if args.tokens <= 0:
+        raise ValueError("--tokens must be positive")
+    if args.tokens > args.max_tok_per_rank:
+        raise ValueError("--tokens must not exceed --max-tok-per-rank")
+    if args.alternations < 2:
+        raise ValueError("--alternations must be at least two")
+
+    rank, world, device = _setup_dist()
+    runner = None
+    recreated = None
+    try:
+        network = NETWORKS[args.network]
+        if network["experts"] % world:
+            raise ValueError("network expert count must be divisible by world size")
+        local_experts = network["experts"] // world
+        route_ids = None
+        if args.route_ids_json is not None:
+            payload = json.loads(args.route_ids_json.read_text())
+            route_ids = torch.tensor(payload["topk_ids"], dtype=torch.int32)
+            if route_ids.shape[0] < args.tokens:
+                raise ValueError("captured route file has fewer rows than --tokens")
+
+        packed_a = _quantize_weights(
+            network["model_dim"],
+            network["inter_dim"],
+            local_experts,
+            rank,
+            17,
+            device,
+        )
+        packed_b = _quantize_weights(
+            network["model_dim"],
+            network["inter_dim"],
+            local_experts,
+            rank,
+            100017,
+            device,
+        )
+        x, route_weights, topk_ids = _make_inputs(
+            args.tokens,
+            network["model_dim"],
+            network["experts"],
+            network["topk"],
+            rank,
+            29,
+            device,
+            force_fanout_boundary=False,
+            inject_invalid_route=False,
+            force_padding_boundary=False,
+            route_ids=None if route_ids is None else route_ids[: args.tokens],
+        )
+        kernel_a = packed_a[:4]
+        kernel_b = packed_b[:4]
+        ptrs_a = _weight_ptrs(packed_a)
+        ptrs_b = _weight_ptrs(packed_b)
+
+        torch.cuda.empty_cache()
+        torch.cuda.reset_peak_memory_stats(device)
+        memory_before_workspace = torch.cuda.memory_allocated(device)
+        runner = MegaMoEV2(
+            rank=rank,
+            world_size=world,
+            quant="a8w4",
+            w1=kernel_a[0],
+            w1_scale=kernel_a[1],
+            w2=kernel_a[2],
+            w2_scale=kernel_a[3],
+            max_tok_per_rank=args.max_tok_per_rank,
+            **network,
+        )
+        memory_after_workspace = torch.cuda.memory_allocated(device)
+        symmetric_count = runner.symmetric_allocation_count
+        symmetric_nbytes = runner.symmetric_allocation_nbytes
+        if symmetric_count <= 0 or symmetric_nbytes <= 0:
+            raise AssertionError("workspace did not report symmetric allocations")
+
+        noncontiguous_w1 = kernel_a[0].reshape(2, -1).transpose(0, 1)
+        try:
+            runner.forward_with_weights(
+                x,
+                route_weights,
+                topk_ids,
+                noncontiguous_w1,
+                kernel_a[1],
+                kernel_a[2],
+                kernel_a[3],
+            )
+        except ValueError as error:
+            if "contiguous" not in str(error):
+                raise
+        else:
+            raise AssertionError("non-contiguous pooled weight did not fail")
+
+        unmarked_w1 = kernel_a[0].detach()
+        if hasattr(unmarked_w1, "is_shuffled"):
+            del unmarked_w1.is_shuffled
+        try:
+            runner.forward_with_weights(
+                x,
+                route_weights,
+                topk_ids,
+                unmarked_w1,
+                kernel_a[1],
+                kernel_a[2],
+                kernel_a[3],
+            )
+        except ValueError as error:
+            if "shuffled" not in str(error):
+                raise
+        else:
+            raise AssertionError("unmarked pooled weight did not fail")
+
+        def run_with(kernel_weights):
+            return runner.forward_with_weights(
+                x,
+                route_weights,
+                topk_ids,
+                *kernel_weights,
+            )
+
+        output_a_first = run_with(kernel_a).clone()
+        _barrier()
+        output_b = run_with(kernel_b).clone()
+        _barrier()
+        memory_steady_start = torch.cuda.memory_allocated(device)
+        for index in range(args.alternations):
+            run_with(kernel_a if index % 2 == 0 else kernel_b)
+        torch.cuda.synchronize()
+        memory_after_alternations = torch.cuda.memory_allocated(device)
+        output_a_last = run_with(kernel_a).clone()
+        _barrier()
+
+        exact_a = torch.tensor(
+            int(torch.equal(output_a_first, output_a_last)),
+            dtype=torch.int32,
+            device=device,
+        )
+        distinct_b = torch.tensor(
+            int(not torch.equal(output_a_first, output_b)),
+            dtype=torch.int32,
+            device=device,
+        )
+        dist.all_reduce(exact_a, op=dist.ReduceOp.MIN)
+        dist.all_reduce(distinct_b, op=dist.ReduceOp.MIN)
+        if not int(exact_a.item()):
+            raise AssertionError("A/B/A alternation changed the repeated A output")
+        if not int(distinct_b.item()):
+            raise AssertionError("independent B weights did not change the output")
+        if _weight_ptrs(packed_a) != ptrs_a or _weight_ptrs(packed_b) != ptrs_b:
+            raise AssertionError("pooled execution replaced a model weight tensor")
+        if runner.symmetric_allocation_count != symmetric_count:
+            raise AssertionError(
+                "symmetric allocation count grew across layer bindings"
+            )
+        if runner.symmetric_allocation_nbytes != symmetric_nbytes:
+            raise AssertionError(
+                "symmetric allocation bytes grew across layer bindings"
+            )
+
+        steady_growth = memory_after_alternations - memory_steady_start
+        if steady_growth > 64 * 1024 * 1024:
+            raise AssertionError(
+                f"steady pooled calls grew allocated memory by {steady_growth} bytes"
+            )
+
+        rel_l2_a = -1.0
+        rel_l2_b = -1.0
+        if args.tokens <= args.accuracy_max_bs:
+            reference_a = _reference(
+                x,
+                route_weights,
+                topk_ids,
+                packed_a[4:],
+                rank,
+                world,
+                network["model_dim"],
+                network["inter_dim"],
+                network["experts"],
+                network["swiglu_limit"],
+            )
+            rel_l2_a = _global_rel_l2(output_a_first, reference_a)
+            reference_b = _reference(
+                x,
+                route_weights,
+                topk_ids,
+                packed_b[4:],
+                rank,
+                world,
+                network["model_dim"],
+                network["inter_dim"],
+                network["experts"],
+                network["swiglu_limit"],
+            )
+            rel_l2_b = _global_rel_l2(output_b, reference_b)
+            if max(rel_l2_a, rel_l2_b) >= args.rtol:
+                raise AssertionError(
+                    f"pooled relL2 A/B={rel_l2_a:.6f}/{rel_l2_b:.6f} "
+                    f"exceeds {args.rtol}"
+                )
+
+        graph_holder = {}
+
+        def graph_body():
+            graph_holder["output"] = run_with(kernel_a)
+
+        graph_body()
+        _barrier()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph, stream=torch.cuda.Stream()):
+            graph_body()
+        run_with(kernel_b)
+        _barrier()
+        graph.replay()
+        torch.cuda.synchronize()
+        graph_exact = torch.tensor(
+            int(torch.equal(graph_holder["output"], output_a_first)),
+            dtype=torch.int32,
+            device=device,
+        )
+        dist.all_reduce(graph_exact, op=dist.ReduceOp.MIN)
+        if not int(graph_exact.item()):
+            raise AssertionError("pooled graph replay changed the A output")
+        graph = None
+        graph_holder.clear()
+        torch.cuda.synchronize()
+
+        metrics = {
+            "rank": rank,
+            "network": args.network,
+            "tokens": args.tokens,
+            "max_tok_per_rank": args.max_tok_per_rank,
+            "alternations": args.alternations,
+            "symmetric_allocation_count": symmetric_count,
+            "symmetric_allocation_nbytes": symmetric_nbytes,
+            "cuda_workspace_delta_bytes": (
+                memory_after_workspace - memory_before_workspace
+            ),
+            "steady_growth_bytes": steady_growth,
+            "peak_cuda_allocated_bytes": torch.cuda.max_memory_allocated(device),
+            "rel_l2_a": rel_l2_a,
+            "rel_l2_b": rel_l2_b,
+            "graph_replay_exact": True,
+            "weight_ptrs_a": ptrs_a,
+            "weight_ptrs_b": ptrs_b,
+        }
+
+        original_device = torch.cuda.current_device()
+        switched_device = original_device
+        if torch.cuda.device_count() > 1:
+            switched_device = (original_device + 1) % torch.cuda.device_count()
+            torch.cuda.set_device(switched_device)
+        runner.close()
+        runner.close()
+        torch.cuda.set_device(original_device)
+        metrics["close_from_device"] = switched_device
+        if runner.symmetric_allocation_count or runner.symmetric_allocation_nbytes:
+            raise AssertionError("close left symmetric allocations tracked")
+        try:
+            runner.forward_with_weights(
+                x,
+                route_weights,
+                topk_ids,
+                *kernel_a,
+            )
+        except RuntimeError as error:
+            if "closed" not in str(error):
+                raise
+        else:
+            raise AssertionError("post-close pooled call did not fail")
+
+        recreated = MegaMoEV2(
+            rank=rank,
+            world_size=world,
+            quant="a8w4",
+            w1=kernel_a[0],
+            w1_scale=kernel_a[1],
+            w2=kernel_a[2],
+            w2_scale=kernel_a[3],
+            max_tok_per_rank=args.max_tok_per_rank,
+            **network,
+        )
+        recreated(x, route_weights, topk_ids)
+        _barrier()
+        recreated.close()
+        recreated.close()
+        metrics["close_recreate"] = True
+
+        gathered = [None] * world
+        dist.all_gather_object(gathered, metrics)
+        if rank == 0:
+            summary = {
+                "status": "PASS",
+                "world_size": world,
+                "ranks": gathered,
+            }
+            if args.output_json is not None:
+                args.output_json.parent.mkdir(parents=True, exist_ok=True)
+                args.output_json.write_text(json.dumps(summary, indent=2) + "\n")
+            print(
+                "[POOLED-WORKSPACE] "
+                f"PASS network={args.network} tokens={args.tokens} "
+                f"mtpr={args.max_tok_per_rank} "
+                f"alternations={args.alternations} symm_count={symmetric_count} "
+                f"symm_gib={symmetric_nbytes / 2**30:.3f} "
+                f"relL2={rel_l2_a:.6f}/{rel_l2_b:.6f} "
+                "graph_replay=PASS close_recreate=PASS",
+                flush=True,
+            )
+    finally:
+        try:
+            if recreated is not None:
+                recreated.close()
+            if runner is not None:
+                runner.close()
+        finally:
+            _cleanup()
+
+
+if __name__ == "__main__":
+    main()
