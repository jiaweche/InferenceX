+def _token_major_to_sorted_routes(
+    values: torch.Tensor,
+    sorted_ids: torch.Tensor,
+    num_valid_ids: torch.Tensor,
+    tokens: int,
+) -> torch.Tensor:
+    """Gather compact [token, slot, K] values into the padded Stage2 row ABI."""
+
+    packed = sorted_ids.to(torch.int64)
+    token = packed & 0x00FFFFFF
+    slot = (packed >> 24) & 0xFF
+    valid = (
+        (
+            torch.arange(sorted_ids.numel(), device=sorted_ids.device)
+            < num_valid_ids[0]
+        )
+        & (token < tokens)
+        & (slot < values.shape[1])
+    )
+    out = torch.zeros(
+        (sorted_ids.numel(), values.shape[-1]),
+        dtype=values.dtype,
+        device=values.device,
+    )
+    out[valid] = values[token[valid], slot[valid]]
+    return out
+
+
